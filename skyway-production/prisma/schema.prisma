datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model User { id String @id @default(cuid()) email String @unique name String? image String? createdAt DateTime @default(now()) bookings Booking[] }
model Airport { id String @id @default(cuid()) iata String @unique name String city String country String lat Float lon Float }
model Airline { id String @id @default(cuid()) iata String? icao String? name String country String flights Flight[] }
model Flight { id String @id @default(cuid()) number String airlineId String airline Airline @relation(fields:[airlineId],references:[id]) originId String destinationId String origin Airport @relation("origin",fields:[originId],references:[id]) destination Airport @relation("destination",fields:[destinationId],references:[id]) lat Float lon Float altitude Int? speed Int? heading Int? status String @default("SCHEDULED") updatedAt DateTime @updatedAt }
model Booking { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id]) type String reference String status String createdAt DateTime @default(now()) }
model Destination { id String @id @default(cuid()) slug String @unique name String country String description String }
